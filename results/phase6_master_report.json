{
  "task": "Phase 6: official Brain2Qwerty v1 keystroke-level baseline on expanded S22",
  "interpretation": "D",
  "interpretation_text": "Official baseline cannot be executed reliably",
  "interpretation_basis": [
    "The exact official model needs about 12 GiB to train (623.5M parameters x 4 fp32 copies) against 3.1 GiB of available commit on this 15.6 GiB laptop.",
    "Compute alone puts the official schedule at 35-71 hours per run and the 100-epoch diagnostic at 12-24 hours per run (12 runs, about 9 days); 2 hours buys 8-16 epochs.",
    "No reduced-epoch run of the same architecture fits in memory, and changing the architecture was not allowed."
  ],
  "what_was_established": {
    "official_model_runs_on_cpu": true,
    "inputs_identical_to_official_dataloader": true,
    "finite_logits_loss_and_decoding": true,
    "official_formulation": "Per-keystroke classification, not sequence transduction. Every keystroke window is encoded independently, keystrokes are grouped by sentence for a transformer, and each keystroke is classified into one of 29 characters. No CTC, no blank."
  },
  "major_findings": {
    "paraphrase_overlap_in_list_splits": {
      "finding": "32 of the 64 list2 sentences are a list1 sentence with one inserted modifier (TF-IDF cosine up to 0.875). The official splitter's paraphrase rule (cosine > 0.5) would keep these pairs together. Splits A-E are exact-text disjoint but not paraphrase-disjoint.",
      "pairs_above_official_threshold": {
        "C": 32,
        "D": 32,
        "E": 32
      },
      "example": {
        "train": "la investigacion recoge los conocimientos",
        "test": "la investigacion real recoge los conocimientos",
        "cosine": 0.8749253854285167
      },
      "consequence": "Can only inflate held-out scores, so the Phase 5Z null result stands; any future positive result on these splits would be confounded."
    },
    "official_environment_incomplete": "the pinned environment lacked x-transformers, einops, einx, loguru, frozendict, Levenshtein and RapidFuzz from the official lock",
    "oracle_segmentation": "The decoder is given the keystroke segmentation: output length always equals the number of keystrokes. Its CER is therefore not comparable with CTC CER, which must infer length.",
    "per_subject_tables": "320,716,800 of 623,548,457 parameters are 200-slot per-subject tables; S22 reaches one slot"
  },
  "reference_numbers_from_earlier_phases": {
    "phase5Z_simplified_ctc_C_character_f1": 0.3133233082706766,
    "phase5Z_ctc_control_C_character_f1": 0.3052585778219791,
